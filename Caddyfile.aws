# Optional Caddy reverse proxy for automatic free Let's Encrypt HTTPS on AWS Lightsail (3.110.6.180)
# Replace bot.yourdomain.com with a real domain pointed to 3.110.6.180, then run:
#   sudo apt install -y caddy && sudo cp Caddyfile.aws /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Then set Upstox Redirect URL -> https://bot.yourdomain.com/api/upstox/callback
# and Upstox Notifier Webhook -> https://bot.yourdomain.com/api/upstox/notifier-webhook

bot.yourdomain.com {
    reverse_proxy 127.0.0.1:3000
}
